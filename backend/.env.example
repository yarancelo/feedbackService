# Backend configuration. Copy to `.env` and adjust. Keep real secrets out of git.

# --- Database ---
# Local single-process default is SQLite (see run-local.sh). Docker/Postgres sets its own.
# DATABASE_URL=sqlite+pysqlite:///./feedback_local.db

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=30

# --- Bitrix24 employee directory ---
# Leave BITRIX_WEBHOOK_URL empty to use the built-in stub list.
# To use the real directory, paste the full INBOUND webhook base URL (with the
# user id and code). The webhook needs the "user" scope (and "department" for
# unit names):
#   BITRIX_WEBHOOK_URL=https://kravtgroup.bitrix24.ru/rest/1848/l3jma9kut8c1c9sq/
BITRIX_WEBHOOK_URL=
BITRIX_CACHE_TTL_MINUTES=1440
BITRIX_TIMEOUT_SECONDS=10
